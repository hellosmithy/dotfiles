# Themes
# ghostty +list-themes
theme = nightfox

# Fonts
# ghostty +list-fonts
font-family = "FiraCode Nerd Font Mono"
# enable ligatures
font-feature = calt
font-feature = liga
font-feature = dlig
font-size = 16

# Option as Meta
macos-option-as-alt = left

# Multiplexing is herdr's job — see ~/.config/herdr/config.toml.
# Uncomment to hand splits/tabs back to Ghostty instead.
# config-file = ?multiplexer.conf

# Quick Terminal
# The `global:` prefix is what makes Ghostty require Accessibility access on
# macOS. Drop this binding and that requirement goes away.
keybind = global:cmd+ctrl+shift+alt+t=toggle_quick_terminal
quick-terminal-screen=mouse
quick-terminal-animation-duration=0
quick-terminal-autohide=1
